# Camada "app" — config não-sensível do Settings (copie p/ app.env, gitignored)
# cp .devcontainer/env/app.env.example .devcontainer/env/app.env
DATABASE_URL=
REDIS_URL=
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
IG_USER_ID=
TIKTOK_MS_TOKEN=
TIKTOK_PROXY=
# Teto de discover() simultâneos por collect (Task 7). Default 2 — ponto de
# partida para benchmark, não limite seguro universal. Vale do startup:
# trocar exige restart do worker (ao contrário de COLLECT_PLATFORMS/LIMIT,
# relidos a cada job).
COLLECT_MAX_CONCURRENCY=2
# Teto de segmentos simultâneos por job (Task 11). Default 3 — 1 por
# segmento do experimento. Lido a cada tick: trocar NÃO exige restart.
WORKER_MAX_SEGMENTS=3
# Teto de discovers simultâneos POR PLATAFORMA no processo (Etapa 0 Task 7).
# Formato plataforma=limite, SOMADO ao default tiktok=1 (1 sessão Playwright
# por vez) — a env ajusta/acrescenta, nunca remove o teto do TikTok; entrada
# inválida (ou limite < 1) é ignorada. Vale do startup: trocar exige restart.
PLATFORM_MAX_CONCURRENCY=tiktok=1
# F5: liga a gravação de web_page_scores no score_job (migração 0010 é
# aditiva). Default 0 — só ligar com veredito "aprovado" na F4 em >= 2 dos 3
# segmentos PT. Kill switch: voltar a 0 restaura o comportamento anterior.
WEB_SCORE_ENABLED=0
