# Camada "app" — config não-sensível do Settings (copie p/ app.env, gitignored)
# cp .devcontainer/env/app.env.example .devcontainer/env/app.env
DATABASE_URL=
REDIS_URL=
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
IG_USER_ID=
TIKTOK_MS_TOKEN=
TIKTOK_PROXY=
# Teto de discover() simultâneos por collect (Task 7). Default 2 — ponto de
# partida para benchmark, não limite seguro universal. Vale do startup:
# trocar exige restart do worker (ao contrário de COLLECT_PLATFORMS/LIMIT,
# relidos a cada job).
COLLECT_MAX_CONCURRENCY=2
# Teto de segmentos simultâneos por job (Task 11). Default 3 — 1 por
# segmento do experimento. Lido a cada tick: trocar NÃO exige restart.
WORKER_MAX_SEGMENTS=3
# Teto de discovers simultâneos POR PLATAFORMA no processo (Etapa 0 Task 7).
# Formato plataforma=limite, SOMADO ao default tiktok=1 (1 sessão Playwright
# por vez) — a env ajusta/acrescenta, nunca remove o teto do TikTok; entrada
# inválida (ou limite < 1) é ignorada. Vale do startup: trocar exige restart.
PLATFORM_MAX_CONCURRENCY=tiktok=1
# F5: liga a gravação de web_page_scores no score_job (migração 0010 é
# aditiva). Default 0 — só ligar com veredito "aprovado" na F4 em >= 2 dos 3
# segmentos PT. Kill switch: voltar a 0 restaura o comportamento anterior.
WEB_SCORE_ENABLED=0
# F1: com 1, segmento sem protocolo q1 válido faz o collect da web FALHAR
# (missing_protocol) em vez de cair em silêncio no legado de 1 consulta.
# Default 0 (comportamento anterior). Ligar em produção junto com o deploy do
# protocolo q1 (o protocolo vive em segments/web-queries/, dentro da imagem).
WEB_QUERIES_REQUIRED=0
# R5 (Bloco 2): fase social do research. Unset/vazio = todas as plataformas do
# segmento (comportamento anterior); "none" = fase social desligada (só
# Suggest/Trends/pool gastam cota); ou lista "youtube,instagram". Vale do
# startup: trocar exige restart do worker.
RESEARCH_SOCIAL_PLATFORMS=
# R7 (Bloco 3): janela da remedição (dias). Só vídeos descobertos nesse
# período entram nos alvos da remedição. Default 7. Vale do startup.
REMEDIATION_WINDOW_DAYS=7
# R7 (Bloco 3): teto de alvos por segmento (10 lotes de 50 ids no
# videos.list do YouTube). Default 500. Vale do startup.
REMEDIATION_LIMIT=500
# R7 (Bloco 3): não remedir vídeo com medição nas últimas N horas — evita
# duas medições com o mesmo captured_at. Default 3. Vale do startup.
REMEDIATION_MIN_GAP_HOURS=3
# R5 (Bloco 4): buscas por coleta no YouTube — uma vaga por origem (seed,
# suggest, trends, hashtag). Default 4. Lida a cada coleta.
SEARCHES_PER_COLLECT_YOUTUBE=4
# R3 (Bloco 4): termos do pool medidos no Google Trends por research (lotes
# de 4 + âncora). Default 16. Vale do startup.
TRENDS_TERMS_PER_DAY=16
